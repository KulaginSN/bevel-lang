generic(T, E)
struct Result:
    T value;
    E error;
    bool is_ok;

i32 main():
    Result(f64, string) res1;
    Result(i32, i32) res2;
    
    res1.value = 3.14;
    res1.is_ok = true;
    
    res2.value = 42;
    res2.error = 0;
    res2.is_ok = true;
    
    if (res1.is_ok && res2.is_ok):
        return 1;
        
    return 0;
