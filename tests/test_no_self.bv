struct Test:
    i32 value;

methods Test:
    i32 get():
        return 5;
    
    i32 add():
        return 6;
    
    i32 mul():
        return 10;

i32 main():
    Test t;
    t.value = 1;
    i32 a = t.get();
    i32 b = t.add();
    i32 c = t.mul();
    if (a == 5 && b == 6 && c == 10):
        return 1;
    return 0;
