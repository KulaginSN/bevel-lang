interface Printable:
    i32 get_value(self);

struct Number:
    i32 value;

methods Number:
    i32 get_value(self):
        return self.value;

i32 main():
    Number n1;
    n1.value = 10;
    
    Number n2;
    n2.value = 20;
    
    i32 sum = n1.get_value() + n2.get_value();
    
    if (sum == 30):
        return 1;
    return 0;
